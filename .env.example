# ===========================================
# Code Intelligence Platform - Environment Configuration
# ===========================================
# This file is a template. Copy to .env and fill in your values.
# ⭐ Language/repo type is AUTO-DETECTED - no need to specify what type of repo you have!

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ===========================================
# GitLab Configuration (Primary Git Provider)
# ===========================================
# Just provide your repos - language is auto-detected!
# No need to specify if it's Java, TypeScript, Python, etc.

# GitLab Personal Access Token (PAT)
# Create at: https://gitlab.com/-/user_settings/personal_access_tokens
# Required scopes: read_repository, read_api
GIT_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Optional: Your GitLab username
GIT_USERNAME=your-username

# Default branch for all repositories
GIT_DEFAULT_BRANCH=main

# Git Provider (gitlab, github, bitbucket, azure_devops)
GIT_PROVIDER=gitlab

# GitLab instance URL (for self-hosted GitLab)
GITLAB_URL=https://gitlab.com

# ===========================================
# Repository Configuration
# ===========================================
# ⭐ IMPORTANT: Language is AUTO-DETECTED from file extensions!
# Just provide the repo URLs - the system will figure out what parser to use.

# Option 1: Simple list of repo URLs (branch defaults to main)
# Example (backend + frontend):
GIT_REPOS=["https://gitlab.com/your-org/backend-repo.git", "https://gitlab.com/eka.io/ui/ui-integration-studio.git"]

# Option 2: Detailed config with custom branches (language still auto-detected)
# GIT_REPOS_CONFIG=[{"url": "https://gitlab.com/org/repo1", "branch": "develop"}, {"url": "https://gitlab.com/org/repo2", "branch": "main"}]

# ===========================================
# Neo4j Graph Database
# ===========================================
# Cloud: neo4j+ssc://xxxx.databases.neo4j.io
# Local: bolt://localhost:7687
NEO4J_URI=neo4j+ssc://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j

# ===========================================
# Qdrant Vector Database
# ===========================================
# Cloud: https://xxxx.region.cloud.qdrant.io:6333
# Local: http://localhost:6333
QDRANT_URL=https://your-cluster.region.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION_NAME=code_embeddings

# ===========================================
# Supabase Configuration
# ===========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key

# ===========================================
# LLM Configuration (using Google Gemini with Service Account)
# ===========================================
# For Gemini/Vertex AI models, use Google Cloud Service Account authentication
# No API key needed - set GOOGLE_CLOUD_SERVICE_ACCOUNT_FILE instead

LLM_PROVIDER=gemini

# Model selection for different agents (supports gemini-2.5-flash, gemini-2.0-flash, etc.)
ARCHITECT_MODEL=gemini-2.5-flash
DEVELOPER_MODEL=gemini-2.5-flash
QA_MODEL=gemini-2.5-flash

# Google Cloud Configuration (required for Gemini models)
# Download your service account JSON from: https://console.cloud.google.com/iam-admin/serviceaccounts
# Make sure the service account has Vertex AI API and Generative AI API permissions
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_SERVICE_ACCOUNT_FILE=./service.json

# Alternative: OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxx
# ARCHITECT_MODEL=gpt-4-turbo-preview

# Alternative: Anthropic Claude
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-xxxx
# ARCHITECT_MODEL=claude-3-opus-20240229

# LLM Parameters
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120

# =============================================
# Embedding Model (Google Vertex AI)
# ===========================================
# Default: text-embedding-004 (768 dims). Ensure QDRANT_VECTOR_SIZE matches.
EMBEDDING_MODEL=text-embedding-004

# Google Cloud (required for embeddings)
GOOGLE_CLOUD_PROJECT_ID=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GOOGLE_CLOUD_SERVICE_ACCOUNT_FILE=./service.json

# ===========================================
# API Configuration
# ===========================================
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=your-secret-key-change-in-production
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ===========================================
# Agent Workflow Configuration
# ===========================================
AGENT_TIMEOUT_SECONDS=300
MAX_WORKFLOW_ITERATIONS=50

# ===========================================
# Feature Flags
# ===========================================
ENABLE_PRD_ANALYSIS=true
ENABLE_QA_GENERATION=true
ENABLE_DEVELOPER_ASSISTANT=true
ENABLE_PR_ANALYSIS=true

# ===========================================
# Optional: Redis Cache
# ===========================================
# REDIS_URL=redis://localhost:6379
# ENABLE_CACHE=true

# ===========================================
# Optional: Monitoring
# ===========================================
# SENTRY_DSN=https://xxx@sentry.io/xxx
# ENABLE_METRICS=true